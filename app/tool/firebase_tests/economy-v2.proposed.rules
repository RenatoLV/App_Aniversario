// STAGE 4A SANDBOX ONLY. Not referenced by app/firebase.json; never deployed here.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /economies_v2/{uid} {
      allow read, write: if false;
      match /wallet/{id} { allow read: if owner(uid); allow write: if false; }
      match /movements/{id} { allow read: if owner(uid); allow write: if false; }
      match /receipts/{id} { allow read: if owner(uid); allow write: if false; }
      match /casinoRounds/{id} { allow read: if owner(uid); allow write: if false; }
      match /casinoState/{id} { allow read: if owner(uid); allow write: if false; }
      match /inventory/{id} { allow read: if owner(uid); allow write: if false; }
      match /origins/{id} { allow read: if owner(uid); allow write: if false; }
      match /compatibility/{id} { allow read: if owner(uid); allow write: if false; }
      match /presentation/{id} { allow read: if owner(uid); allow write: if false; }
      // Server evidence, seeds/keys, tickets and administrative review are private.
      match /{privatePath=**} { allow read, write: if false; }
    }
    // Representative legacy permission solely for restoration-isolation tests.
    // The separate baseline run loads the COMPLETE unchanged application rules.
    match /players/{uid}/progress/{id} {
      allow read: if owner(uid);
      allow create: if owner(uid) && request.resource.data.revision == 1
        && request.resource.data.payload is string && request.resource.data.payload.size() < 850000;
      allow update: if owner(uid) && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.payload is string && request.resource.data.payload.size() < 850000;
    }
  }
}
