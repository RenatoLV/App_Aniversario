rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /spaces/{space}/notes/{note}/{version} {
      function member() {
        return request.auth != null && firestore.exists(/databases/(default)/documents/spaces/$(space)/members/$(request.auth.uid));
      }
      allow read: if member();
      allow create: if member() && request.resource.size < 6 * 1024 * 1024 && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }
  }
}
